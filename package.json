{
  "name": "hostelconnect",
  "private": true,
  "workspaces": [
    "backend/*",
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run -w @hostelconnect/api dev",
    "dev:worker": "npm run -w @hostelconnect/worker dev",
    "dev:portal": "npm run -w @hostelconnect/portal dev",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "recharts": "^3.2.1"
  }
}
