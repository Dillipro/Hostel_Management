{
  "name": "ceg-hostel-student-portal",
  "version": "1.0.0",
  "description": "Digital Hostel Management System - Student Portal for CEG Anna University",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": [
    "hostel-management",
    "student-portal",
    "ceg-anna-university",
    "react",
    "nodejs",
    "mongodb"
  ],
  "authors": [
    "Dilli Babu R - 2023115086",
    "Jothi Prakesh B - 2023115111", 
    "Manoj Kumar K - 2023115314"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5",
    "nodemailer": "^6.9.4",
    "razorpay": "^2.9.2",
    "qrcode": "^1.5.3",
    "pdfkit": "^0.13.0",
    "socket.io": "^4.7.2",
    "moment": "^2.29.4",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.1",
    "dotenv": "^16.3.1",
    "cloudinary": "^1.40.0",
    "twilio": "^4.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
